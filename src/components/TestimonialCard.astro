---
// src/components/TestimonialCard.astro
export interface Props {
  quote: string;
  author: string;
  rating: number; // A number from 1 to 5
}

const { quote, author, rating } = Astro.props;
---

<div class="card">
  <div class="stars">
    {Array(rating).fill(0).map(() => <span>&#9733;</span>)}
  </div>
  <p class="quote">"{quote}"</p>
  <p class="author">- {author}</p>
</div>

<style>
  .card {
    background-color: var(--white);
    padding: 2rem;
    border-radius: 5px;
    border: 1px solid var(--pale-dogwood);
  }

  .stars {
    color: var(--hunyadi-golden);
    margin-bottom: 1rem;
  }

  .quote {
    font-style: italic;
    margin-bottom: 1rem;
  }

  .author {
    font-weight: 700;
    text-align: right;
  }
</style>
