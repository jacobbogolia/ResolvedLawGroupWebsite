<style>
  .about-features {
    background: linear-gradient(180deg, var(--dark-background) 0%, var(--secondary-background) 100%);
    padding: 96px 0;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .features-header {
    margin-bottom: 32px;
  }

  .title-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .top-subtitle {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle-text {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 224px;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .main-title {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.25;
    margin: 0;
  }

  .features-grid {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .feature-card {
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 32px;
    flex: 1;
    max-width: 392px;
  }

  .feature-icon {
    width: 56px;
    height: 54px;
    color: var(--main-content);
    margin-bottom: 16px;
  }

  .feature-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-title {
    font-family: var(--font-main);
    font-size: 26px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.35;
    margin: 0;
  }

  .feature-divider {
    width: 100%;
    height: 1px;
    background-color: var(--secondary-strong-accent);
    opacity: 0.4;
  }

  .feature-description {
    font-family: var(--font-secondary);
    font-size: 16px;
    line-height: 1.8;
    color: var(--secondary-strong-accent);
    margin: 0;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
    
    .main-title {
      font-size: 40px;
    }
    
    .features-grid {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .features-grid {
      flex-direction: column;
      gap: 2rem;
    }
    
    .feature-card {
      max-width: none;
    }
    
    .main-title {
      font-size: 32px;
    }
  }
</style>
