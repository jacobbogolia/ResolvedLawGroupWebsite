---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<h1 class="blog-h1">{content}</h1>

<style>
  .blog-h1 {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
