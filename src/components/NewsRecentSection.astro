<style>
  .recent-section {
    background: linear-gradient(to bottom, var(--dark-background), var(--secondary-background));
    padding: 96px 0;
    position: relative;
    z-index: 4;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 48px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.25;
    margin: 0;
    max-width: 498px;
  }

  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .blog-row {
    display: flex;
    gap: 32px;
  }

  .blog-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-image {
    aspect-ratio: 310/190;
    background-color: var(--main-content);
    border-radius: 5px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder {
    width: 24px;
    height: 24px;
    color: var(--light-text);
    opacity: 0.6;
  }

  .card-content {
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-content h3 {
    font-family: var(--font-main);
    font-size: 26px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.35;
    margin: 0;
    flex: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }

  .date {
    font-family: var(--font-secondary);
    font-weight: 400;
    color: var(--secondary-neutral-accent);
  }

  .read-more {
    font-family: var(--font-secondary);
    font-weight: 700;
    color: var(--main-accent-dark);
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }

    .blog-row {
      gap: 1rem;
    }
  }

  @media (max-width: 768px) {
    .blog-row {
      flex-direction: column;
      gap: 1rem;
    }

    h2 {
      font-size: 2.5rem;
    }

    .card-content h3 {
      font-size: 1.5rem;
    }
  }
</style>
