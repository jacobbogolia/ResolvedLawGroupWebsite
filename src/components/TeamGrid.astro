---
// TeamGrid component for the team page
import TeamMemberCard from './TeamMemberCard.astro';

const teamMembers = [
  {
    name: 'Katy Grace Kinney',
    title: 'FOUNDER & CEO OF RESOLVED',
    specialization: 'Specialised in Criminal & Administrative Law',
    image: '/team/katy.jpg',
    quote: 'My daily motivation to get things moving:',
    quoteText: '"Thirsty hollow bezoar house 20 emporium cutting banquet invisibility wingardium. Headmaster motorcycle professor dervish firs\' 9¾ suits wizard. Feast toad-like flame moon leprechaun."',
    isExpanded: true,
    isFounder: true
  },
  {
    name: 'Kim Lane Lehner',
    title: 'INTELLECTUAL PROPERTY LAWYER',
    specialization: 'Specialised in Intellectual Property Law',
    image: '/team/kim.jpg',
    quote: 'My approach to intellectual property:',
    quoteText: '"Protecting innovation requires both legal expertise and creative thinking. Every patent, trademark, and copyright represents someone\'s dream."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Grace Stanton',
    title: 'CIVIL LITIGATION ATTORNEY',
    specialization: 'Specialised in Civil & Administrative Law',
    image: '/team/grace.jpg',
    quote: 'What drives me in civil litigation:',
    quoteText: '"Every case is about people seeking justice. I fight to ensure their voices are heard in the courtroom."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Taylor Morgan',
    title: 'CORPORATE LAWYER',
    specialization: 'Specialised in Corporate & Business Law',
    image: '/team/taylor.jpg',
    quote: 'My philosophy on corporate law:',
    quoteText: '"Business success requires solid legal foundations. I help companies grow while staying compliant."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Jordan Lee',
    title: 'ENVIRONMENTAL LAW ATTORNEY',
    specialization: 'Specialised in Environmental & Land Use Law',
    image: '/team/jordan.jpg',
    quote: 'Why environmental law matters:',
    quoteText: '"Protecting our planet for future generations is the most important work we can do."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Alexis Taylor',
    title: 'FAMILY LAW ATTORNEY',
    specialization: 'Specialised in Family & Divorce Law',
    image: '/team/alexis.jpg',
    quote: 'My commitment to families:',
    quoteText: '"Family law is about helping people through their most difficult times with compassion and expertise."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Jordan Kim',
    title: 'EMPLOYMENT LAW ATTORNEY',
    specialization: 'Specialised in Labor & Employment Law',
    image: '/team/jordan-kim.jpg',
    quote: 'What employment law means to me:',
    quoteText: '"Fair treatment in the workplace is a fundamental right. I fight for workers\' rights every day."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Casey Parker',
    title: 'TAX ATTORNEY',
    specialization: 'Specialised in Tax Law & Planning',
    image: '/team/casey.jpg',
    quote: 'My approach to tax law:',
    quoteText: '"Tax planning isn\'t about avoiding taxes—it\'s about paying your fair share while maximizing your opportunities."',
    isExpanded: false,
    isFounder: false
  },
  {
    name: 'Jamie Chen',
    title: 'REAL ESTATE LAWYER',
