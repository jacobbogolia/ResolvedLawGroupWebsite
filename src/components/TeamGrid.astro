---

<section class="team-grid">
  <div class="container">
    <div class="team-header">
      <div class="header-content">
        <div class="subtitle">
          <span>Quidditch must holly dobby</span>
          <div class="subtitle-line"></div>
        </div>
        <h2>Founder & Legal Team</h2>
      </div>
      <div class="header-logo">
        <div class="logo-container">
          <div class="logo-icon"></div>
          <div class="logo-text">R</div>
        </div>
      </div>
    </div>
    
    <div class="team-members">
      <div class="team-column">
        {teamMembers.slice(0, 7).map(member => (
          <TeamMemberCard {...member} />
        ))}
      </div>
      <div class="team-column">
        {teamMembers.slice(7).map(member => (
          <TeamMemberCard {...member} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .team-grid {
    background: linear-gradient(180deg, var(--dark-background) 0%, var(--secondary-background) 100%);
    padding: 96px 0;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .team-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 48px;
  }

  .header-content {
    flex: 0 0 498px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 208px;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.25;
    margin: 0;
  }

  .header-logo {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .logo-container {
    position: relative;
    width: 111px;
    height: 111px;
  }

  .logo-icon {
    width: 111px;
    height: 111px;
    background: linear-gradient(135deg, var(--main-accent-light) 0%, var(--main-accent-dark) 100%);
    border-radius: 50%;
    position: absolute;
    top: 0;
    left: 0;
  }

  .logo-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-main);
    font-size: 48px;
    font-weight: 700;
    color: var(--main-content);
    z-index: 1;
  }

  .team-members {
    display: grid;
    grid-template-columns: 604px 604px;
    gap: 32px;
  }

  .team-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
    
    .team-members {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    
    h2 {
      font-size: 40px;
    }
  }

  @media (max-width: 768px) {
    .team-header {
      flex-direction: column;
      gap: 2rem;
    }
    
    .header-content {
      flex: none;
    }
    
    .team-members {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    h2 {
      font-size: 32px;
    }
  }
</style>
