---
export interface Props {
  title?: string;
  content: string;
}

const { title = "Conclusion", content } = Astro.props;
---

<div class="blog-conclusion">
  <h2 class="conclusion-title">{title}</h2>
  <div class="conclusion-content" set:html={content}></div>
</div>

<style>
  .blog-conclusion {
    background-color: var(--offset-background);
    border-radius: 5px;
    box-shadow: 8px 8px 0px 0px var(--dark-background);
    padding: 32px;
    margin: 32px 0;
    color: var(--main-content);
  }

  .conclusion-title {
    font-family: var(--font-main);
    font-size: 44px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--main-content);
    margin: 0 0 16px 0;
  }

  .conclusion-content {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--main-content);
    opacity: 0.8;
  }

  .conclusion-content p {
    margin: 0 0 16px 0;
  }

  .conclusion-content p:last-child {
    margin-bottom: 0;
  }
</style>
