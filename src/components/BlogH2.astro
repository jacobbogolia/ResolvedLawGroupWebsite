---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<h2 class="blog-h2">{content}</h2>

<style>
  .blog-h2 {
    font-family: var(--font-main);
    font-size: 44px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
