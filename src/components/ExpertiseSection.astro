---
// src/components/ExpertiseSection.astro
export interface Props {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  features: string[];
  imageText: string;
  layout: 'left' | 'right';
}

const { id, title, subtitle, description, features, imageText, layout } = Astro.props;
---

<section id={id} class="expertise-section">
  <div class="container">
    <div class={`expertise-content ${layout === 'right' ? 'reverse' : ''}`}>
      <div class="text-content">
        <div class="subtitle">
          <span>{subtitle}</span>
          <div class="subtitle-line"></div>
        </div>
        <h2>{title}</h2>
        <p class="description">{description}</p>
        <div class="features">
          {features.map((feature) => (
            <div class="feature-item">
              <div class="feature-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="2"/>
                  <path d="M6 10l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="feature-text">{feature}</span>
              <div class="feature-divider"></div>
            </div>
          ))}
        </div>
        <a href="#contact" class="cta-button">
          <span>Book an Appointment</span>
          <svg class="add-icon" width="22" height="22" viewBox="0 0 22 22" fill="none">
            <circle cx="11" cy="11" r="10" stroke="currentColor" stroke-width="2"/>
            <path d="M11 7v8M7 11h8" stroke="currentColor" stroke-width="2"/>
          </svg>
        </a>
      </div>
      <div class="image-content">
        <div class="image-placeholder">
          <div class="placeholder-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" fill="currentColor"/>
            </svg>
          </div>
          <p class="placeholder-text">{imageText}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .expertise-section {
    padding: 96px 0;
    background: linear-gradient(to bottom, var(--secondary-background), var(--dark-background));
    position: relative;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .expertise-content {
    display: flex;
    gap: 138px;
    align-items: center;
  }

  .expertise-content.reverse {
    flex-direction: row-reverse;
  }

  .text-content {
    flex: 1;
    max-width: 498px;
    padding: 64px 0;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.25;
    margin: 0 0 32px 0;
  }

  .description {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.8;
    margin-bottom: 32px;
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .feature-icon {
    flex-shrink: 0;
    color: var(--main-accent-light);
  }

  .feature-text {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 600;
    color: var(--main-accent-light);
    flex: 1;
  }

  .feature-divider {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 24px;
    border: 1px solid var(--sunset);
    border-radius: 5px;
    color: var(--light-text);
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 700;
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  .add-icon {
    flex-shrink: 0;
  }

  .image-content {
    flex: 1;
    max-width: 498px;
  }

  .image-placeholder {
    width: 100%;
    height: 704px;
    background-color: var(--main-content);
    border-radius: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: relative;
  }

  .placeholder-icon {
    color: var(--light-text);
    opacity: 0.6;
  }

  .placeholder-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    opacity: 0.2;
    text-align: center;
    max-width: 400px;
    line-height: 1.25;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
    
    .expertise-content {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .expertise-content {
      flex-direction: column;
      gap: 2rem;
    }
    
    .expertise-content.reverse {
      flex-direction: column;
    }
    
    .text-content {
      padding: 0;
    }
    
    h2 {
      font-size: 2.5rem;
    }
    
    .image-placeholder {
      height: 400px;
    }
    
    .placeholder-text {
      font-size: 1.5rem;
    }
  }
</style>
