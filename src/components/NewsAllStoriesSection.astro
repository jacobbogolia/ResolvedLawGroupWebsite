<style>
  .all-stories-section {
    background: linear-gradient(to bottom, var(--dark-background), var(--secondary-background));
    padding: 96px 0;
    position: relative;
    z-index: 1;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin: 0;
  }

  .stories-grid {
    display: flex;
    gap: 32px;
    margin-bottom: 32px;
  }

  .stories-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .story-card {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .story-image {
    width: 310px;
    height: 190px;
    background-color: var(--main-content);
    border-radius: 5px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .image-placeholder {
    width: 24px;
    height: 24px;
    color: var(--light-text);
    opacity: 0.6;
  }

  .story-content {
    flex: 1;
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 24px;
    height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .story-content h3 {
    font-family: var(--font-main);
    font-size: 22px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.35;
    margin: 0;
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .story-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    margin-top: auto;
  }

  .date {
    font-family: var(--font-secondary);
    font-weight: 400;
    color: var(--secondary-neutral-accent);
  }

  .read-more {
    font-family: var(--font-secondary);
    font-weight: 700;
    color: var(--main-accent-dark);
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  .load-more-section {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .load-more-btn {
    background-color: transparent;
    border: 1px solid var(--sunset);
    border-radius: 5px;
    padding: 12px 24px;
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 700;
    color: var(--main-content);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .load-more-btn:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }

    .stories-grid {
      gap: 1rem;
    }
  }

  @media (max-width: 768px) {
    .stories-grid {
      flex-direction: column;
      gap: 1rem;
    }

    .story-card {
      flex-direction: column;
    }

    .story-image {
      width: 100%;
      height: 200px;
    }

    .story-content {
      height: auto;
    }

    h2 {
      font-size: 3rem;
    }

    .story-content h3 {
      font-size: 1.25rem;
    }
  }
</style>
