---
// src/components/Footer.astro
---
<footer>
  <div class="container">
    <div class="logo-section">
      <a href="/" class="logo">
        <img src="/logo.svg" alt="Resolved Law Group Logo" />
        <span>Resolved Law Group</span>
      </a>
      <p>Compassionate, experienced, and relentless representation.</p>
    </div>
    <div class="links-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="#">About Us</a></li>
        <li><a href="#">Practice Areas</a></li>
        <li><a href="#">Our Team</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">Contact Us</a></li>
      </ul>
    </div>
    <div class="contact-section">
      <h4>Contact Us</h4>
      <ul>
        <li>123 Legal Ave, Colorado Springs, CO</li>
        <li>(719) 256-0236</li>
        <li>consults@resolvedlawgroup.com</li>
      </ul>
    </div>
  </div>
  <div class="bottom-bar">
    <div class="container">
      <p>&copy; 2023 Resolved Law Group. All Rights Reserved.</p>
      <div class="legal-links">
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: var(--night);
    color: var(--white);
    padding-top: 4rem;
  }

  footer .container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    padding: 0 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-main);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .logo img {
    height: 50px;
  }

  h4 {
    color: var(--sunset);
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    margin-bottom: 0.5rem;
  }

  a {
    color: var(--white);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .bottom-bar {
    background-color: #000;
    padding: 1rem 0;
    margin-top: 4rem;
  }

  .bottom-bar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .legal-links {
    display: flex;
    gap: 1rem;
  }
</style>
