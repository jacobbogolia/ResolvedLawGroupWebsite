---
// NewsInsightsHero.astro
---

<section class="news-hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-left">
        <div class="hero-title">
          <div class="subtitle">
            <span>Forest must ollivanders expecto</span>
            <div class="subtitle-line"></div>
          </div>
          <h1>Law & Legal Insights</h1>
        </div>
        
        <div class="featured-section">
          <div class="featured-label">
            <span>FEATURED BLOG INSIGHT</span>
            <div class="label-line"></div>
          </div>
          <div class="featured-card">
            <div class="featured-image">
              <div class="image-placeholder">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
                  <path d="M9 9h6v6H9z" fill="currentColor"/>
                </svg>
              </div>
            </div>
            <div class="featured-content">
              <h2>Quidditch yaxley polyjuice mimubulus trace golden. Steak hunt suck sticking crush.</h2>
              <div class="post-meta">
                <span class="date">18 August 2025</span>
                <span class="read-more">Read More</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="hero-right">
        <div class="popular-title">
          <div class="subtitle">
            <span>Galleons 12 feather chess</span>
            <div class="subtitle-line"></div>
          </div>
          <h3>Popular Stories</h3>
        </div>
        
        <div class="popular-stories">
          <div class="story-card">
            <p>Chance releases scales 12 section. Shunpike charm sticking duel powder beaded. 12 mellow expecto no bat.</p>
            <div class="story-meta">
              <span class="date">19 July 2025</span>
              <span class="read-more">Read More</span>
            </div>
          </div>
          
          <div class="story-card">
            <p>Them sticking bezoar nick juice parchment trace. Trevor beaters pigwidgeon.</p>
            <div class="story-meta">
              <span class="date">3 February 2025</span>
              <span class="read-more">Read More</span>
            </div>
          </div>
          
          <div class="story-card">
            <p>Parchment match fire orbs knickerbocker. Mrs grindylows knight-bus.</p>
            <div class="story-meta">
              <span class="date">23 August 2025</span>
              <span class="read-more">Read More</span>
            </div>
          </div>
          
          <div class="story-card">
            <p>Padma motorcycle holyhead stand raw-steak wars. Avada pumpkin shell kedavra cauldron splinched potion petrificus kiss.</p>
            <div class="story-meta">
              <span class="date">24 August 2025</span>
              <span class="read-more">Read More</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Background patterns -->
  <div class="pattern pattern-1"></div>
  <div class="pattern pattern-2"></div>
  <div class="texture-overlay"></div>
</section>

<style>
  .news-hero {
    background-color: var(--secondary-background);
    padding: 96px 0;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: flex;
    gap: 137px;
    align-items: flex-start;
  }

  .hero-left {
    flex: 0 0 710px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h1 {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin: 0;
  }

  .featured-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .featured-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .featured-label span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .label-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .featured-image {
    aspect-ratio: 310/190;
    background-color: var(--main-content);
    border-radius: 5px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder {
    width: 24px;
    height: 24px;
    color: var(--light-text);
    opacity: 0.6;
  }

  .featured-content {
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 24px;
  }

  .featured-content h2 {
    font-family: var(--font-main);
    font-size: 32px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.35;
    margin: 0 0 12px 0;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }

  .date {
    font-family: var(--font-secondary);
    font-weight: 400;
    color: var(--secondary-neutral-accent);
  }

  .read-more {
    font-family: var(--font-secondary);
    font-weight: 700;
    color: var(--main-accent-dark);
    text-decoration: underline;
    text-decoration-style: dotted;
  }

  .hero-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .popular-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 111px;
    justify-content: center;
  }

  .popular-title h3 {
    font-family: var(--font-main);
    font-size: 44px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.3;
    margin: 0;
  }

  .popular-stories {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .story-card {
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 24px;
    height: 163px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .story-card p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .story-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }

  /* Background patterns */
  .pattern {
    position: absolute;
    width: 480px;
    height: 480px;
    border-radius: 25px;
    opacity: 0.1;
    pointer-events: none;
  }

  .pattern-1 {
    top: -54px;
    left: -240px;
    background: radial-gradient(circle, var(--main-accent-light) 0%, transparent 70%);
  }

  .pattern-2 {
    bottom: 0;
    right: 0;
    background: radial-gradient(circle, var(--main-accent-light) 0%, transparent 70%);
  }

  .texture-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="%23FFC781" opacity="0.1"/><circle cx="80" cy="40" r="1" fill="%23FFC781" opacity="0.1"/><circle cx="40" cy="80" r="1" fill="%23FFC781" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.2;
    pointer-events: none;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }

    .hero-content {
      gap: 2rem;
    }

    .hero-left {
      flex: 0 0 50%;
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column;
      gap: 2rem;
    }

    .hero-left {
      flex: none;
    }

    h1 {
      font-size: 3rem;
    }

    .popular-title h3 {
      font-size: 2.5rem;
    }
  }
</style>
