---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<h4 class="blog-h4">{content}</h4>

<style>
  .blog-h4 {
    font-family: var(--font-main);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
