---
export interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="blog-numbered-list">
  {items.map((item, index) => (
    <div class="list-item">
      <div class="number-dot">
        <span class="number">{index + 1}.</span>
      </div>
      <p class="list-text">{item}</p>
    </div>
  ))}
</div>

<style>
  .blog-numbered-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 32px 0;
  }

  .list-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 0 10px;
  }

  .number-dot {
    flex-shrink: 0;
    width: 16px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .number {
    font-family: 'Area Normal', var(--font-secondary);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.8;
    color: var(--main-accent-light);
    text-align: center;
    width: 16px;
  }

  .list-text {
    flex: 1;
    font-family: 'Area Normal', var(--font-secondary);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.8;
    color: var(--light-text);
    margin: 0;
  }
</style>
