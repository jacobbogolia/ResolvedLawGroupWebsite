---
// src/components/Stats.astro
---
<section class="stats">
  <div class="container">
    <div class="stat">
      <h3>Estates over $8 Million</h3>
      <p>Experience with high value - unique asset cases</p>
    </div>
    <div class="stat">
      <h3>20% Dismissal Rate</h3>
      <p>100% of charges, completely dropped by prosecution</p>
    </div>
  </div>
</section>

<style>
  .stats {
    background-color: var(--secondary-background);
    color: var(--light-text);
    padding: 64px 0;
  }

  .container {
    display: grid;
    grid-template-columns: 604px 604px;
    gap: 32px;
    align-items: center;
  }

  .stat {
    padding: 32px;
  }

  .stat h3 {
    font-family: var(--font-secondary);
    font-size: 57px;
    font-weight: 700;
    color: var(--light-text);
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .stat p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.2;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .stat h3 {
      font-size: 2.5rem;
    }

    .stat p {
      font-size: 1.2rem;
    }
  }
</style>
