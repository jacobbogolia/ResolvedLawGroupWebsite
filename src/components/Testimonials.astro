---
// src/components/Testimonials.astro
import TestimonialCard from './TestimonialCard.astro';

const testimonials = [
  {
    quote: "Resolved Law Group handled my case with the utmost professionalism and care. I couldn't have asked for a better outcome.",
    author: "Jane D.",
    rating: 5,
  },
  {
    quote: "From the initial consultation to the final verdict, their team was supportive, knowledgeable, and relentless in fighting for me.",
    author: "John S.",
    rating: 5,
  },
];
---

<section class="testimonials">
  <div class="container">
    <h2>Testimonials from Our Clients</h2>
    <div class="grid">
      {testimonials.map(testimonial => (
        <TestimonialCard {...testimonial} />
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 4rem 2rem;
    background-color: var(--dark-green);
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    text-align: center;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
</style>
