---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<h5 class="blog-h5">{content}</h5>

<style>
  .blog-h5 {
    font-family: var(--font-main);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
