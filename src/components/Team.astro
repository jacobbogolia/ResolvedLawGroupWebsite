---
// src/components/Team.astro
import TeamMemberCard from './TeamMemberCard.astro';

const teamMembers = [
  {
    name: 'Katy Grace Kinney',
    title: 'FOUNDER & CEO OF RESOLVED',
    specialization: 'Specialised in Criminal & Administrative Law',
    image: '/team/kari.jpg', // Placeholder
  },
  {
    name: 'Kim Lane Lehner',
    title: 'INTELLECTUAL PROPERTY LAWYER',
    specialization: 'Specialised in Intellectual Property Law',
    image: '/team/kimberly.jpg', // Placeholder
  },
  {
    name: 'Grace Stanton',
    title: 'CIVIL LITIGATION ATTORNEY',
    specialization: 'Specialised in Civil & Administrative Law',
    image: '/team/grace.jpg', // Placeholder
  },
];
---

<section class="team">
  <div class="container">
    <div class="team-content">
      <div class="team-left">
        <div class="subtitle">
          <span>Dementors leprechaun a quidditch</span>
          <div class="subtitle-line"></div>
        </div>
        <h2>Resolved Founder and the Team Behind</h2>
        <p>
          Spectacles plums cores nick portrait dragon-scale glasses. Of do beans wingardium second werewolf out. Suck parchment owl green years yew splinched head. Ridgeback flame bonnet locket phials weasley. Eyes bedroom alohamora weasley petrified than armchairs. Section keeper heir spectacles hearing be 20 kidney.
        </p>
        <a href="#" class="btn btn-primary">More on Founder & Team</a>
      </div>
      <div class="team-right">
        <div class="team-members">
          {teamMembers.map(member => (
            <TeamMemberCard {...member} />
          ))}
          <div class="more-members">
            <p>And 9 more Lawyers View our Full Team to Learn More</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .team {
    padding: 96px 0;
    background-color: var(--secondary-background);
    color: var(--light-text);
  }

  .team-content {
    display: grid;
    grid-template-columns: 498px 604px;
    gap: 78px;
    align-items: start;
  }

  .team-left {
    max-width: 498px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 15px;
    font-weight: 400;
    color: var(--light-text);
  }

  .subtitle-line {
    width: 262px;
    height: 1px;
    background-color: var(--light-text);
    opacity: 0.3;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 63px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin-bottom: 32px;
  }

  p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-secondary);
    font-size: 14px;
    transition: all 0.3s ease;
    border: 1px solid var(--sunset);
    display: inline-block;
  }

  .btn-primary {
    background-color: transparent;
    color: var(--light-text);
    border-color: var(--sunset);
  }

  .btn-primary:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  .team-right {
    max-width: 604px;
  }

  .team-members {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .more-members {
    padding: 24px;
    text-align: center;
    margin-top: 16px;
  }

  .more-members p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.2;
    margin: 0;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }

    .team-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .team-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h2 {
      font-size: 3rem;
    }

    .more-members p {
      font-size: 1.5rem;
    }
  }
</style>
