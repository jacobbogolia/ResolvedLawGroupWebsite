---
// src/components/Team.astro
import TeamMemberCard from './TeamMemberCard.astro';

const teamMembers = [
  {
    name: 'Kari Grace Kinney',
    title: 'Founding Partner & CEO',
    image: '/team/kari.jpg', // Placeholder
  },
  {
    name: 'Kimberly Long-Leitner',
    title: 'Senior Associate Attorney',
    image: '/team/kimberly.jpg', // Placeholder
  },
  {
    name: 'Grace Sutton',
    title: 'Associate Attorney',
    image: '/team/grace.jpg', // Placeholder
  },
];
---

<section class="team">
  <div class="container">
    <h2>Meet the Team Behind the Results</h2>
    <div class="grid">
      {teamMembers.map(member => (
        <TeamMemberCard {...member} />
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    padding: 4rem 2rem;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
</style>
