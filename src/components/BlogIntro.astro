---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<p class="blog-intro">{content}</p>

<style>
  .blog-intro {
    font-family: var(--font-secondary);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
