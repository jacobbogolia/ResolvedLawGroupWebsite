---
// src/components/ResidingInColorado.astro
---
<section class="residing-in-colorado">
  <div class="container">
    <div class="text-content">
      <h2>Residing in Colorado Springs</h2>
      <p>
        Our firm is proud to call Colorado Springs home. We are deeply committed to serving our community and providing the highest quality legal services to our neighbors.
      </p>
      <a href="#" class="learn-more-button">Learn More About Us</a>
    </div>
    <div class="image-content">
      <img src="/colorado-springs.jpg" alt="Colorado Springs Courthouse" />
    </div>
  </div>
</section>

<style>
  .residing-in-colorado {
    background-color: var(--dark-green);
    color: var(--white);
    padding: 4rem 2rem;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  p {
    margin-bottom: 2rem;
  }

  .learn-more-button {
    background-color: var(--caramel);
    color: var(--white);
    padding: 1rem 2rem;
    text-decoration: none;
    font-weight: 700;
    border-radius: 5px;
    transition: background-color 0.3s ease;
  }

  .learn-more-button:hover {
    background-color: #a56736; /* Darker caramel */
  }

  .image-content img {
    width: 100%;
    height: auto;
    border-radius: 5px;
  }
</style>
