---
// src/components/PracticeAreaCard.astro
export interface Props {
  title: string;
  description: string;
  icon: string; // Path to icon
}

const { title, description, icon } = Astro.props;
---

<div class="card">
  <img src={icon} alt="" class="icon" />
  <h3>{title}</h3>
  <p>{description}</p>
  <a href="#">Learn More</a>
</div>

<style>
  .card {
    background-color: var(--seashell);
    padding: 2rem;
    border-radius: 5px;
    text-align: center;
  }

  .icon {
    height: 50px;
    margin-bottom: 1rem;
  }

  h3 {
    margin-bottom: 1rem;
  }

  p {
    margin-bottom: 1.5rem;
  }

  a {
    color: var(--caramel);
    text-decoration: none;
    font-weight: 700;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
