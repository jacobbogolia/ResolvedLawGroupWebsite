---
// src/components/PracticeAreas.astro
import PracticeAreaCard from './PracticeAreaCard.astro';

const practiceAreas = [
  {
    title: 'Criminal Defense',
    description: 'We would love to be your criminal defense attorney in Colorado Springs. We even bring previous prosecution experience to the table.',
    icon: '⚖️',
  },
  {
    title: 'Divorce',
    description: 'Colorado Springs divorce attorneys are not all the same. We won\'t rack up bogus bills. See how we can be your affordable divorce attorney Colorado Springs.',
    icon: '👥',
  },
  {
    title: 'Civil Protection Orders',
    description: 'Secure bodily safety and peace of mind. We know how to get you a civil protection order fast in Colorado Springs. We\'d love to learn your situation and help you fast.',
    icon: '🛡️',
  },
  {
    title: 'Child Custody',
    description: 'Nothing is more important than your child. We strive to be the best child custody lawyer in Colorado Springs. Let\'s chat and you can see for yourself',
    icon: '👨‍👩‍👧‍👦',
  },
];
---

<section class="practice-areas">
  <div class="container">
    <div class="section-header">
      <div class="logo-section">
        <div class="logo-r">
          <svg width="111" height="111" viewBox="0 0 111 111" fill="none">
            <circle cx="55.5" cy="55.5" r="55.5" fill="var(--main-accent-light)"/>
            <text x="55.5" y="70" text-anchor="middle" font-family="var(--font-main)" font-size="60" font-weight="700" fill="var(--main-content)">R</text>
          </svg>
        </div>
      </div>
      <div class="title-section">
        <div class="subtitle">
          <span>Focused & Specialized</span>
          <div class="subtitle-line"></div>
        </div>
        <h2>Legal Practice Areas</h2>
      </div>
    </div>
    
    <div class="practice-grid">
      {practiceAreas.map(area => (
        <PracticeAreaCard {...area} />
      ))}
    </div>
    
    <div class="bottom-section">
      <div class="scroll-indicator">
        <span>Scroll or drag to see more</span>
        <div class="scroll-bar">
          <div class="scroll-track">
            <div class="scroll-dots">
              <div class="dot"></div>
              <div class="dot"></div>
              <div class="dot active"></div>
              <div class="dot"></div>
            </div>
          </div>
        </div>
      </div>
      <a href="#" class="view-all-button">View All</a>
    </div>
  </div>
</section>

<style>
  .practice-areas {
    padding: 96px 0;
    background-color: var(--secondary-background);
    position: relative;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: 48px;
    margin-bottom: 48px;
  }

  .logo-section {
    flex-shrink: 0;
  }

  .logo-r {
    width: 111px;
    height: 111px;
  }

  .title-section {
    flex: 1;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 15px;
    font-weight: 400;
    color: var(--light-text);
  }

  .subtitle-line {
    width: 267px;
    height: 1px;
    background-color: var(--light-text);
    opacity: 0.3;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 63px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin: 0;
  }

  .practice-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-bottom: 50px;
  }

  .bottom-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .scroll-indicator span {
    font-family: var(--font-secondary);
    font-size: 22px;
    font-weight: 400;
    color: var(--light-text);
  }

  .scroll-bar {
    width: 1116px;
    height: 24px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 6px;
  }

  .scroll-track {
    width: 100%;
    height: 12px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    position: relative;
  }

  .scroll-dots {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    gap: 4px;
  }

  .dot {
    width: 2px;
    height: 8px;
    background-color: var(--light-text);
    opacity: 0.3;
    border-radius: 1px;
  }

  .dot.active {
    opacity: 1;
  }

  .view-all-button {
    background-color: transparent;
    color: var(--light-text);
    padding: 12px 24px;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-secondary);
    font-size: 14px;
    border: 1px solid var(--sunset);
    border-radius: 5px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .view-all-button:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      gap: 24px;
    }

    .practice-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .bottom-section {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }

    .scroll-bar {
      width: 100%;
    }

    h2 {
      font-size: 2.5rem;
    }
  }
</style>
