---
// src/components/TeamMemberCard.astro
export interface Props {
  name: string;
  title: string;
  specialization: string;
  image: string;
}

const { name, title, specialization, image } = Astro.props;
---

<div class="card">
  <div class="avatar">
    <div class="avatar-placeholder"></div>
  </div>
  <div class="info">
    <h4>{name}</h4>
    <div class="title-badge">
      <span>{title}</span>
    </div>
    <p>{specialization}</p>
  </div>
</div>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    background-color: transparent;
    padding: 24px;
    border-radius: 8px;
    width: 604px;
    height: 151px;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--main-accent-light) 0%, var(--sunset) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .avatar-placeholder {
    width: 18px;
    height: 18px;
    background: var(--main-content);
    border-radius: 50%;
  }

  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h4 {
    font-family: var(--font-secondary);
    font-size: 26px;
    font-weight: 700;
    color: var(--light-text);
    margin: 0;
    line-height: 1.35;
  }

  .title-badge {
    background-color: var(--main-content);
    padding: 2px 6px;
    border-radius: 4px;
    width: fit-content;
  }

  .title-badge span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--light-text);
    text-transform: uppercase;
  }

  p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    margin: 0;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .card {
      width: 100%;
      height: auto;
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }

    h4 {
      font-size: 2rem;
    }

    .title-badge span {
      font-size: 1rem;
    }

    p {
      font-size: 1.2rem;
    }
  }
</style>
