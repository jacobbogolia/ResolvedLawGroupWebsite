---
// src/components/TeamMemberCard.astro
export interface Props {
  name: string;
  title: string;
  specialization: string;
  image: string;
  quote?: string;
  quoteText?: string;
  isExpanded?: boolean;
  isFounder?: boolean;
}

const { name, title, specialization, image, quote, quoteText, isExpanded = false, isFounder = false } = Astro.props;
---

<div class={`card ${isFounder ? 'founder-card' : ''} ${isExpanded ? 'expanded' : ''}`}>
  <div class="main-content">
    <div class="avatar">
      <div class="avatar-placeholder"></div>
    </div>
    <div class="info">
      <h4>{name}</h4>
      <div class="title-badge">
        <span>{title}</span>
      </div>
      <p>{specialization}</p>
    </div>
  </div>
  
  {isExpanded && quote && quoteText && (
    <div class="quote-section">
      <div class="quote-divider"></div>
      <div class="quote-content">
        <div class="quote-header">
          <div class="quote-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h4v10h-10z" fill="currentColor"/>
            </svg>
          </div>
          <p class="quote-title">{quote}</p>
        </div>
        <p class="quote-text">{quoteText}</p>
      </div>
    </div>
  )}
</div>

<style>
  .card {
    background-color: rgba(9, 52, 46, 0.5);
    border: 1px solid var(--dark-background);
    border-radius: 5px;
    padding: 24px;
    width: 604px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .card.founder-card {
    background-color: var(--dark-background);
    border: 1px solid var(--sunset);
  }

  .card:hover {
    border-color: var(--main-accent-light);
  }

  .main-content {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 5px;
    background-color: var(--main-content);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 10px;
  }

  .avatar-placeholder {
    width: 18px;
    height: 18px;
    background: var(--light-text);
    border-radius: 50%;
  }

  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h4 {
    font-family: var(--font-main);
    font-size: 32px;
    font-weight: 400;
    color: var(--light-text);
    margin: 0;
    line-height: 1.35;
  }

  .title-badge {
    background-color: var(--main-accent-dark);
    padding: 2px 6px;
    border-radius: 5px;
    width: fit-content;
  }

  .title-badge span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--light-text);
    text-transform: uppercase;
  }

  p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    margin: 0;
    line-height: 1.35;
  }

  .quote-section {
    margin-top: 16px;
  }

  .quote-divider {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
    margin-bottom: 16px;
  }

  .quote-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .quote-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .quote-icon {
    width: 32px;
    height: 32px;
    color: var(--main-accent-light);
    flex-shrink: 0;
  }

  .quote-title {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 700;
    color: var(--main-accent-light);
    margin: 0;
    line-height: 1.8;
  }

  .quote-text {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .card {
      width: 100%;
      padding: 16px;
    }

    .main-content {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }

    h4 {
      font-size: 24px;
    }

    .title-badge span {
      font-size: 10px;
    }

    p {
      font-size: 14px;
    }

    .quote-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
