---
// src/components/Blog.astro
import BlogPostCard from './BlogPostCard.astro';

const featuredPost = {
  title: 'That boggarts baubles every wand dittany banges vanishing',
  date: '18 August 2025',
  image: '/blog/featured.jpg', // Placeholder
};

const blogPosts = [
  {
    title: 'Dead us robes sticking glasses woes potter mischief. Squashy mcgonagall gillywater',
    date: '18 August 2025',
    image: '/blog/post1.jpg', // Placeholder
  },
  {
    title: 'Cabinet quidditch potion which cabbage fritters trelawney',
    date: '23 August 2025',
    image: '/blog/post2.jpg', // Placeholder
  },
  {
    title: 'Weekly the lies large voldemort elf filch. Tears sopophorous lived venom fluffy bee lemon',
    date: '26 August 2025',
    image: '/blog/post3.jpg', // Placeholder
  },
];
---

<section class="blog">
  <div class="container">
    <div class="blog-content">
      <div class="blog-left">
        <div class="subtitle">
          <span>Proudly nerdy</span>
          <div class="subtitle-line"></div>
        </div>
        <h2>Latest News & Insights from our Blog</h2>
        <div class="featured-post">
          <div class="featured-label">
            <span>FEATURED BLOG INSIGHT</span>
            <div class="label-line"></div>
          </div>
          <div class="featured-card">
            <div class="featured-image">
              <div class="image-placeholder"></div>
            </div>
            <div class="featured-content">
              <h3>{featuredPost.title}</h3>
              <div class="post-meta">
                <span class="date">{featuredPost.date}</span>
                <span class="read-more">Read More</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="blog-right">
        <div class="blog-posts">
          {blogPosts.map(post => (
            <BlogPostCard {...post} />
          ))}
        </div>
        <div class="blog-cta">
          <p>Interested in viewing more news and insights on law? Check out our specialised blog to see more.</p>
          <a href="#" class="btn btn-primary">View more Insights</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .blog {
    padding: 96px 0;
    background-color: var(--secondary-background);
    color: var(--light-text);
  }

  .blog-content {
    display: grid;
    grid-template-columns: 392px 710px;
    gap: 104px;
    align-items: start;
  }

  .blog-left {
    max-width: 392px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 15px;
    font-weight: 400;
    color: var(--light-text);
  }

  .subtitle-line {
    width: 110px;
    height: 1px;
    background-color: var(--light-text);
    opacity: 0.3;
  }

  h2 {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin-bottom: 32px;
  }

  .featured-post {
    margin-top: 32px;
  }

  .featured-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .featured-label span {
    font-family: var(--font-secondary);
    font-size: 15px;
    font-weight: 400;
    color: var(--light-text);
  }

  .label-line {
    width: 163px;
    height: 1px;
    background-color: var(--light-text);
    opacity: 0.3;
  }

  .featured-card {
    background-color: transparent;
    border-radius: 8px;
    overflow: hidden;
  }

  .featured-image {
    width: 100%;
    height: 240px;
    background: linear-gradient(135deg, var(--secondary-background) 0%, var(--dark-background) 100%);
    position: relative;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2C1810 0%, #134A42 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-content {
    padding: 24px;
  }

  .featured-content h3 {
    font-family: var(--font-secondary);
    font-size: 26px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.35;
    margin-bottom: 16px;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .date {
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 400;
    color: var(--light-text);
  }

  .read-more {
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 400;
    color: var(--light-text);
    text-decoration: underline;
  }

  .blog-right {
    max-width: 710px;
  }

  .blog-posts {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 32px;
  }

  .blog-cta {
    text-align: center;
    padding: 24px;
  }

  .blog-cta p {
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-secondary);
    font-size: 14px;
    transition: all 0.3s ease;
    border: 1px solid var(--sunset);
    display: inline-block;
  }

  .btn-primary {
    background-color: transparent;
    color: var(--light-text);
    border-color: var(--sunset);
  }

  .btn-primary:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }

    .blog-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .blog-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h2 {
      font-size: 3rem;
    }

    .featured-content h3 {
      font-size: 2rem;
    }

    .blog-cta p {
      font-size: 1.5rem;
    }
  }
</style>
