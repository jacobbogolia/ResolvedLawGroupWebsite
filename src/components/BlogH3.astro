---
export interface Props {
  content: string;
}

const { content } = Astro.props;
---

<h3 class="blog-h3">{content}</h3>

<style>
  .blog-h3 {
    font-family: var(--font-main);
    font-size: 38px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--light-text);
    margin: 0 0 32px 0;
  }
</style>
