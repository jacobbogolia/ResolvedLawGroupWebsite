<style>
  .about-services {
    background: linear-gradient(180deg, var(--dark-background) 0%, var(--secondary-background) 100%);
    padding: 96px 0;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .services-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 48px;
  }

  .title-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .top-subtitle {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle-text {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 229px;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .main-title {
    font-family: var(--font-main);
    font-size: 50px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.25;
    margin: 0;
    max-width: 498px;
  }

  .logo-section {
    flex: 0 0 auto;
    margin-left: 48px;
  }

  .logo-icon {
    width: 344px;
    height: 111px;
    color: var(--main-accent-light);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: start;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-image {
    height: 230px;
    margin-bottom: 8px;
  }

  .image-placeholder {
    background-color: var(--main-content);
    border-radius: 5px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .placeholder-icon {
    width: 24px;
    height: 24px;
    color: var(--light-text);
  }

  .service-content {
    background-color: var(--white);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .service-title {
    font-family: var(--font-main);
    font-size: 32px;
    font-weight: 400;
    color: var(--main-content);
    line-height: 1.35;
    margin: 0;
  }

  .service-divider {
    width: 100%;
    height: 1px;
    background-color: var(--secondary-strong-accent);
    opacity: 0.4;
  }

  .service-description {
    font-family: var(--font-secondary);
    font-size: 16px;
    line-height: 1.8;
    color: var(--secondary-strong-accent);
    margin: 0;
    flex: 1;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    padding: 8px 16px;
    text-decoration: none;
    color: var(--secondary-background);
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .service-cta:hover {
    background-color: var(--secondary-background);
    color: var(--light-text);
  }

  .cta-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
    
    .services-header {
      flex-direction: column;
      gap: 2rem;
    }
    
    .logo-section {
      margin-left: 0;
    }
    
    .main-title {
      font-size: 40px;
    }
    
    .services-grid {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .main-title {
      font-size: 32px;
    }
    
    .logo-icon {
      width: 100%;
      height: auto;
    }
  }
</style>
