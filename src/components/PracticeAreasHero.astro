---
// src/components/PracticeAreasHero.astro
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="subtitle">
        <span>Specialized focus</span>
        <div class="subtitle-line"></div>
      </div>
      <h1>Best Practices: Family Law & Criminal Law</h1>
    </div>
  </div>
  <!-- Decorative pattern -->
  <div class="pattern"></div>
</section>

<style>
  .hero {
    background-color: var(--secondary-background);
    padding: 48px 0;
    position: relative;
    overflow: hidden;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 636px;
  }

  .subtitle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .subtitle span {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--main-accent-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .subtitle-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  h1 {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    color: var(--light-text);
    line-height: 1.1;
    margin: 0;
  }

  .pattern {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(255, 199, 129, 0.1) 0%, transparent 70%);
    border-radius: 25px;
    opacity: 0.1;
    z-index: 1;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 3rem;
    }
    
    .pattern {
      display: none;
    }
  }
</style>
