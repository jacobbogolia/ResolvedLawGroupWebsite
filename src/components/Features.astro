</section>

<style>
  .features {
    background-color: var(--secondary-background);
    padding: 96px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1240px;
    margin: 0 auto;
  }

  .feature-card {
    background-color: transparent;
    padding: 32px;
    border-radius: 8px;
    position: relative;
  }

  .feature-icon {
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .feature-content h3 {
    font-family: var(--font-secondary);
    font-size: 26px;
    font-weight: 700;
    color: var(--light-text);
    margin-bottom: 24px;
    line-height: 1.35;
  }

  .separator {
    width: 100%;
    height: 1px;
    background-color: var(--light-text);
    opacity: 0.3;
    margin-bottom: 24px;
  }

  .feature-content p {
    font-family: var(--font-secondary);
    font-size: 16px;
    font-weight: 400;
    color: var(--light-text);
    line-height: 1.6;
    opacity: 0.9;
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    
    .feature-card {
      padding: 24px;
    }
  }
</style>
