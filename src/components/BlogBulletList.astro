---
export interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="blog-bullet-list">
  {items.map((item) => (
    <div class="list-item">
      <div class="bullet-dot">
        <svg width="16" height="29" viewBox="0 0 16 29" fill="none">
          <circle cx="8" cy="14.5" r="2" fill="var(--main-accent-light)"/>
        </svg>
      </div>
      <p class="list-text">{item}</p>
    </div>
  ))}
</div>

<style>
  .blog-bullet-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 32px 0;
  }

  .list-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 0 10px;
  }

  .bullet-dot {
    flex-shrink: 0;
    width: 16px;
    height: 29px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .list-text {
    flex: 1;
    font-family: 'Area Normal', var(--font-secondary);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.8;
    color: var(--light-text);
    margin: 0;
  }
</style>
