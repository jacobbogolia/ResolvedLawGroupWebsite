---
// src/components/JumpToExpertise.astro
---

<section class="jump-to-expertise">
  <div class="container">
    <div class="jump-nav">
      <p class="jump-label">JUMP TO EXPERTISE</p>
      <div class="jump-links">
        <a href="#criminal-law" class="jump-link">Criminal Law</a>
        <a href="#family-law" class="jump-link">Family Law</a>
        <a href="#civil-protection-orders" class="jump-link">Civil Protection Orders</a>
        <a href="#child-custody" class="jump-link">Child Custody</a>
        <a href="#intellectual-property" class="jump-link">Intellectual Property Law</a>
        <a href="#corporate-law" class="jump-link">Corporate Law</a>
        <a href="#contact" class="jump-link cta-link">Get in Touch</a>
      </div>
    </div>
  </div>
</section>

<style>
  .jump-to-expertise {
    background: linear-gradient(to bottom, var(--dark-background), var(--secondary-background));
    padding: 32px 0 64px;
    position: relative;
    z-index: 2;
  }

  .container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .jump-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .jump-label {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    color: var(--background-shade);
    opacity: 0.6;
    margin: 0;
  }

  .jump-links {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .jump-link {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid var(--sunset);
    border-radius: 5px;
    color: var(--light-text);
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 700;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .jump-link:hover {
    background-color: var(--main-accent-light);
    color: var(--main-content);
  }

  .cta-link {
    background-color: var(--main-accent-light);
    color: var(--main-content);
    flex: 1;
    text-align: center;
  }

  .cta-link:hover {
    background-color: var(--sunset);
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .jump-links {
      flex-direction: column;
    }
    
    .jump-link {
      text-align: center;
    }
  }
</style>
