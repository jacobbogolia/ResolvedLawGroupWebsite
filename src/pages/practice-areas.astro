---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PracticeAreasHero from '../components/PracticeAreasHero.astro';
import JumpToExpertise from '../components/JumpToExpertise.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import Contact from '../components/Contact.astro';
import Stats from '../components/Stats.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <PracticeAreasHero />
    <JumpToExpertise />
    <ExpertiseSection 
      id="criminal-law"
      title="Criminal Law"
      subtitle="LOCAL COLORADO SPRINGS DEFENSE LAWYER"
      description="No matter how complicated the case, we can handle it. Felony lawyers? We got them. Dealing with camera crews while prosecuting Robert Durst for the murder of Susan Berman has given our leadership with the ability to stay calm under any pressure. Your case is just as important, allow our experience from both sides of the courtroom to give you the best advantage for moving on to the next chapter of your life. We're ready when you are."
      features={[
        "2 Specialised Criminal Law Attorneys",
        "Over 18 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Criminal Law"
      layout="left"
    />
    <ExpertiseSection 
      id="family-law"
      title="Family Law"
      subtitle="COLORADO SPRINGS FAMILY LAW ATTORNEYS"
      description="Family law is a wide catch-all, and we can catch it all. Whether it's a Colorado Springs child custody case, or you just need a quick Divorce lawyer, you can trust us to handle the particulars. When your family & foundation is in flux, everything is harder. After working under other firms in town that prioritize maximizing billable hours and churning through clients, we decided to branch out and start a new approach. We found clients tend to want three things: To be heard, to be treated fairly (by their attorney and the court) and to move onto the next chapter of their lives. Believe us, the sooner we start, the better the odds will be in your favor."
      features={[
        "3 Specialised Civil Law Attorneys",
        "Over 12 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Civil Law"
      layout="right"
    />
    <ExpertiseSection 
      id="civil-protection-orders"
      title="Civil Protection Orders"
      subtitle="PEACE OF MIND"
      description="Safety at home and out in public is paramount. We know the process, and would love to help you. There is no reason to delay securing your peace of mind again. Processes exist to protect you, and we know how to get them to work for you."
      features={[
        "4 Specialised Administrative Law Attorneys",
        "Over 11 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Administrative Law"
      layout="left"
    />
    <ExpertiseSection 
      id="child-custody"
      title="Child Custody"
      subtitle="WHAT MATTERS MOST"
      description="Whether you need to modify an order or start from the beginning, we would love to help. Our team has extremely well versed child custody attorneys that can work hard to get you the time you need to ensure your child is well taken care of."
      features={[
        "3 Specialised Constitutional Law Attorneys",
        "Over 16 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Constitutional Law"
      layout="right"
    />
    <ExpertiseSection 
      id="intellectual-property"
      title="Intellectual Property"
      subtitle="Spleens 50 10 woes glasses"
      description="Bezoar out me treacle boy. Woes counter-clockwise wizard splinched mellow mimubulus thirsty. Answer the lights lady newt. Hoops mcgonagall me half-blood restricted would chocolate owl niffler. Weekly phoenix lies goblet elf releases wingardium potion mewing."
      features={[
        "1 Specialised Intellectual Property Law Attorney",
        "Over 6 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Intellectual Property Law"
      layout="left"
    />
    <ExpertiseSection 
      id="corporate-law"
      title="Corporate Law"
      subtitle="Spleens law floo"
      description="Room who catherine drills sinistra. Mr minister downfall leprechaun with. Easy that half-blood requirement umbrella. Butter erised for gamp's bagman erumpent glory whomping norwegian swiveling. Cabbage dungeons granger 'zis great."
      features={[
        "2 Specialised Corporate Law Attorneys",
        "Over 9 years of Team Experience in the niche",
        "Free Consultation for your case"
      ]}
      imageText="Photo Related to Corporate Law"
      layout="right"
    />
    <Contact />
    <Stats />
  </main>
  <Footer />
</Layout>
