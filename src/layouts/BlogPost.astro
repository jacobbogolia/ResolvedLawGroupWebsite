<style>
  .hero-section {
    background: linear-gradient(to bottom, var(--dark-background), var(--secondary-background));
    padding: 64px 0 96px;
    min-height: 100vh;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 340px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
    width: 100%;
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .title {
    padding: 0 212px;
    width: 100%;
  }

  .title h1 {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--light-text);
    margin: 0;
  }

  .metadata {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 0 212px;
    width: 100%;
  }

  .metadata p {
    font-family: var(--font-secondary);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
    color: var(--main-accent-light);
    margin: 0;
  }

  .label {
    color: var(--light-text);
  }

  .value {
    font-family: 'Area Normal', var(--font-secondary);
    font-weight: 600;
  }

  .divider {
    width: 1px;
    height: 14px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .hero-image {
    width: 100%;
    height: 697px;
    background-color: var(--main-content);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--light-text);
    opacity: 0.5;
  }

  .main-content {
    padding: 0 212px;
    width: 100%;
  }

  .more-stories {
    margin-top: 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
  }

  .stories-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .category-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .category {
    font-family: var(--font-secondary);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--main-accent-light);
    text-transform: uppercase;
    margin: 0;
  }

  .category-line {
    width: 100%;
    height: 1px;
    background-color: var(--main-accent-light);
    opacity: 0.4;
  }

  .stories-title {
    font-family: var(--font-main);
    font-size: 64px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--light-text);
    margin: 0;
  }

  .stories-grid {
    display: flex;
    gap: 32px;
    width: 100%;
  }

  .stories-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .story-card {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    width: 100%;
  }

  .story-image {
    width: 310px;
    height: 190px;
    background-color: var(--main-content);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    flex-shrink: 0;
  }

  .story-content {
    flex: 1;
    background-color: var(--offset-background);
    border: 1px solid var(--secondary-background);
    border-radius: 5px;
    height: 190px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .story-content h3 {
    font-family: var(--font-main);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.35;
    color: var(--main-content);
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .story-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 14px;
    line-height: 1.8;
  }

  .date {
    font-family: var(--font-secondary);
    font-weight: 400;
    color: var(--secondary-neutral-accent);
  }

  .read-more {
    flex: 1;
    font-family: var(--font-secondary);
    font-weight: 700;
    color: var(--main-accent-dark);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-align: right;
  }

  .read-more:hover {
    color: var(--main-accent-light);
  }

  @media (max-width: 1440px) {
    .container {
      padding: 0 2rem;
    }
    
    .title,
    .metadata,
    .main-content {
      padding: 0 1rem;
    }
  }

  @media (max-width: 1024px) {
    .stories-grid {
      flex-direction: column;
    }
    
    .story-card {
      flex-direction: column;
    }
    
    .story-image {
      width: 100%;
      height: 200px;
    }
    
    .story-content {
      height: auto;
      min-height: 150px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 32px 0 48px;
    }
    
    .title h1 {
      font-size: 48px;
    }
    
    .stories-title {
      font-size: 48px;
    }
    
    .container {
      padding: 0 1rem;
    }
    
    .title,
    .metadata,
    .main-content {
      padding: 0;
    }
  }
</style>
